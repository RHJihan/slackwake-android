<!-- Android 12+. Only settings are backed up. The diagnostic log never leaves the
     device. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/settings.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/settings.json" />
    </device-transfer>
</data-extraction-rules>
