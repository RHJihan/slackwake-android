<resources>
    <!-- Window-level themes only; all visible UI is Compose Material 3. -->
    <style name="Theme.SlackWake" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Shortcut trampoline: no window of its own unless it must show the flash warning. -->
    <style name="Theme.SlackWake.Translucent" parent="android:Theme.Translucent.NoTitleBar" />

    <!-- Opaque black until Compose draws (no lock-screen wallpaper bleeding through). -->
    <style name="Theme.SlackWake.Alert" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
