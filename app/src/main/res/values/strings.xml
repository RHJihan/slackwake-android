    <string name="mute_title">Mute by keyword</string>
    <string name="mute_caption">Skip the alert, sound, and flash for matching pings — everything else still wakes you.</string>
    <string name="mute_field">Muted keywords</string>
    <string name="mute_help">A ping is muted when its sender, channel, or text contains any of these (case-insensitive). Wrap a phrase in double quotes to match it exactly, including commas. Prefix an entry with // to comment it out.</string>
    <string name="mute_placeholder">standup, #random, \"This is a test notification\"</string>
    <string name="allow_title">Alert only by keyword</string>
    <string name="allow_caption">Wake you only for matching pings — everything else stays silent.</string>
    <string name="allow_field">Allowed keywords</string>
    <string name="allow_help">Only pings whose sender, channel, or text contains one of these will wake you (case-insensitive). Wrap a phrase in double quotes to match it exactly, including commas. Prefix an entry with // to comment it out. Leave empty to disable.</string>
    <string name="allow_placeholder">@here, #incidents, \"on call\"</string>
    <string name="both_filters_title">Both filters are on</string>
    <string name="both_filters_body">A ping wakes you only if it matches an allowed keyword and does not match a muted keyword. If a keyword is in both lists, muting wins.</string>

