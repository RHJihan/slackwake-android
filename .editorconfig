root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 160
# Compose convention: @Composable functions are PascalCase nouns.
ktlint_function_naming_ignore_when_annotated_with = Composable
